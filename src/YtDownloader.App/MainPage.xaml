<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YtDownloader.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YtDownloader.App"
    xmlns:vm="using:YtDownloader.App.ViewModels">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Padding="24,12,24,32"
            Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Download a video" />

            <!--  First-run engine setup  -->
            <InfoBar
                Title="Setting up the download engine"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsInstallingEngine, Mode=OneWay}"
                Message="{x:Bind ViewModel.EngineStatus, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.Content>
                    <ProgressBar
                        Margin="0,0,0,12"
                        Maximum="100"
                        Value="{x:Bind ViewModel.EngineProgress, Mode=OneWay}" />
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                Title="Setup failed"
                IsClosable="False"
                IsOpen="{x:Bind local:MainPage.HasText(ViewModel.EngineError), Mode=OneWay}"
                Message="{x:Bind ViewModel.EngineError, Mode=OneWay}"
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.EnsureEngineCommand}" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  Link input  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="UrlBox"
                    IsEnabled="{x:Bind ViewModel.CanUseApp, Mode=OneWay}"
                    KeyDown="UrlBox_KeyDown"
                    PlaceholderText="Paste a YouTube link"
                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Click="Paste_Click"
                    IsEnabled="{x:Bind ViewModel.CanUseApp, Mode=OneWay}"
                    ToolTipService.ToolTip="Paste link from clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE77F;" />
                        <TextBlock Text="Paste" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    MinWidth="96"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.FetchInfoCommand}"
                    Content="Fetch"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind ViewModel.FetchInfoCommand.IsRunning, Mode=OneWay}">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Looking up video…" />
            </StackPanel>

            <InfoBar
                Title="Couldn't load that link"
                IsOpen="{x:Bind local:MainPage.HasText(ViewModel.FetchError), Mode=OneWay}"
                Message="{x:Bind ViewModel.FetchError, Mode=OneWay}"
                Severity="Error" />

            <!--  Preview + options  -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                <StackPanel Spacing="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="224"
                            Height="126"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Image Source="{x:Bind local:MainPage.Thumbnail(ViewModel.Video), Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                MaxLines="3"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Video.Title, Mode=OneWay, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind local:MainPage.Byline(ViewModel.Video), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Quality"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.QualityOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Save to" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Stretch"
                                    Click="ChangeFolder_Click"
                                    Content="Change…"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!--  Progress  -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}">
                        <ProgressBar
                            IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,-12,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.DownloadStatus, Mode=OneWay}"
                        Visibility="{x:Bind local:MainPage.VisibleIfText(ViewModel.DownloadStatus), Mode=OneWay}" />

                    <InfoBar
                        Title="Download failed"
                        IsOpen="{x:Bind local:MainPage.HasText(ViewModel.DownloadError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.DownloadError, Mode=OneWay}"
                        Severity="Error" />

                    <InfoBar
                        Title="Download complete"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasCompletedFile, Mode=OneWay}"
                        Message="{x:Bind ViewModel.CompletedFileName, Mode=OneWay}"
                        Severity="Success">
                        <InfoBar.Content>
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="OpenFile_Click" Content="Open" />
                                <Button Click="ShowInFolder_Click" Content="Show in folder" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.DownloadCancelCommand}"
                            Content="Cancel"
                            Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}" />
                        <Button
                            MinWidth="120"
                            Command="{x:Bind ViewModel.DownloadCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE896;" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
