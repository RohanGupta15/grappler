<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YtDownloader.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="GroupHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,24,0,4" />
        </Style>
    </Page.Resources>

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        CornerRadius="8,8,0,0">
        <ScrollViewer>
            <StackPanel
                MaxWidth="1000"
                Padding="24,28,24,32"
                Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Downloads" />
                <tk:SettingsCard Description="{x:Bind ViewModel.Settings.OutputFolder, Mode=OneWay}" Header="Save downloads to">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE838;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button Click="ChangeFolder_Click" Content="Change folder" />
                </tk:SettingsCard>
                <tk:SettingsCard Description="Used when you add a link. You can change it per download while it waits." Header="Default quality">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE714;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.QualityChoices}"
                        SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
                </tk:SettingsCard>
                <tk:SettingsCard Description="More is faster on a fast connection." Header="Downloads at the same time">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </tk:SettingsCard.HeaderIcon>
                    <NumberBox
                        MinWidth="120"
                        Maximum="5"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.MaxConcurrent, Mode=TwoWay}" />
                </tk:SettingsCard>
                <tk:SettingsCard Description="When you switch to this window with a YouTube link copied." Header="Offer links from the clipboard">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77F;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.OfferClipboard, Mode=TwoWay}" />
                </tk:SettingsCard>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Extras for new downloads" />
                <tk:SettingsCard Description="Saved as an .srt file next to the video when the video has them." Header="Subtitles">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F0;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.SubtitleChoices}"
                        SelectedItem="{x:Bind ViewModel.SelectedSubtitles, Mode=TwoWay}" />
                </tk:SettingsCard>
                <tk:SettingsCard Description="Cuts sponsor reads out using SponsorBlock community data." Header="Skip sponsor segments">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE893;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.SkipSponsors, Mode=TwoWay}" />
                </tk:SettingsCard>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="Download engine" />
                <tk:SettingsExpander
                    Description="{x:Bind ViewModel.EngineStatus, Mode=OneWay}"
                    Header="yt-dlp, Deno and FFmpeg"
                    IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button Command="{x:Bind ViewModel.CheckForUpdatesCommand}" Content="Check for updates" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="yt-dlp">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.YtDlpVersion, Mode=OneWay}" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Deno">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.DenoVersion, Mode=OneWay}" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="FFmpeg">
                            <TextBlock
                                MaxWidth="360"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.FfmpegVersion, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="About" />
                <tk:SettingsCard Description="Downloading from YouTube can go against its Terms of Service. Only keep videos you have the right to." Header="YT Downloader">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </tk:SettingsCard.HeaderIcon>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Version 1.0" />
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
